<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        本字典只负责「形状与组件样式」+ 任务状态色板。
        强调色与底色配色已拆分到 Styles/Palettes/*.xaml（运行时可整体热切换，
        由 Ui/ThemePalette.Apply 替换 App 合并字典中的方案项，必须排在 Common 之后合并）。
    -->

    <!-- 页面与卡片规格：各分区页统一内边距、圆角、描边 -->
    <Thickness x:Key="PageContentPadding">32,20,32,20</Thickness>
    <Thickness x:Key="CardPadding">16,13</Thickness>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <x:Double x:Key="SectionSpacing">12</x:Double>

    <!-- 全局控件圆角覆盖：默认模板经 ThemeResource 引用，TextBox/Button/ComboBox 一起变圆润 -->
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontSize" Value="26" />
    </Style>

    <Style x:Key="ItemTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- 需要浮起感的卡片（输入区、设置区） -->
    <Style x:Key="ElevatedCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
    </Style>

    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="20,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SearchBoxStyle" TargetType="TextBox">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="MaxWidth" Value="300" />
    </Style>

    <!--
      状态色板（任务/历史状态胶囊用）。代码侧按明暗主题取 Fg 键；
      Bg 为同色系低透明度浅底，在明暗两种主题的卡片底色上都可读，故不分主题。
      键直接平铺在本字典（不放 ThemeDictionaries），保证 Application.Current.Resources
      的代码索引查找 100% 命中。
    -->
    <SolidColorBrush x:Key="StatusSuccessFg" Color="#0F7B0F" />
    <SolidColorBrush x:Key="StatusSuccessFgDark" Color="#6CCB5F" />
    <SolidColorBrush x:Key="StatusSuccessBg" Color="#150F7B0F" />
    <SolidColorBrush x:Key="StatusCriticalFg" Color="#C42B1C" />
    <SolidColorBrush x:Key="StatusCriticalFgDark" Color="#FF99A4" />
    <SolidColorBrush x:Key="StatusCriticalBg" Color="#15C42B1C" />
    <SolidColorBrush x:Key="StatusCautionFg" Color="#9A5B00" />
    <SolidColorBrush x:Key="StatusCautionFgDark" Color="#F7B04B" />
    <SolidColorBrush x:Key="StatusCautionBg" Color="#159A5B00" />
    <SolidColorBrush x:Key="StatusAttentionFg" Color="#0F6CBD" />
    <SolidColorBrush x:Key="StatusAttentionFgDark" Color="#6CB8F6" />
    <SolidColorBrush x:Key="StatusAttentionBg" Color="#150F6CBD" />
    <SolidColorBrush x:Key="StatusNeutralFg" Color="#616161" />
    <SolidColorBrush x:Key="StatusNeutralFgDark" Color="#C8C8C8" />
    <SolidColorBrush x:Key="StatusNeutralBg" Color="#12616161" />

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- 任务列表行内的静默图标按钮组 -->
    <Style x:Key="RowIconAction" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- 输入卡里的胶囊形小按钮（保存目录等次要设置项） -->
    <Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <!-- 卡片式列表的容器行：去掉默认最小高度并给行间留白 -->
    <Style x:Key="RowItemStyle" TargetType="ListViewItem">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

</ResourceDictionary>
