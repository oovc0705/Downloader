<?xml version="1.0" encoding="utf-8" ?>
<!--
    配色方案：森野绿意  色相 120°（森林绿）
    设计规则（换色必读，五套方案一致）：
    1. 底色不透明、带明确色相（浅色 L≈92%，深色 L≈10% 带绿）——换方案一眼可辨；
    2. 表面（卡片/输入/分层）近中性白/深灰，与底色拉开明度差，靠描边立层次，
       色相不下渗大面积表面（否则整体发灰）；
    3. 强调色只出现在交互元素；
    4. NavigationView 内容区/顶栏透明露出底色；所有填充均落在不透明底上，杜绝透色。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#3E7C4F</Color>
            <Color x:Key="SystemAccentColorLight1">#4C8D5E</Color>
            <Color x:Key="SystemAccentColorLight2">#5FA070</Color>
            <Color x:Key="SystemAccentColorLight3">#8CBD98</Color>
            <Color x:Key="SystemAccentColorDark1">#336742</Color>
            <Color x:Key="SystemAccentColorDark2">#295335</Color>
            <Color x:Key="SystemAccentColorDark3">#1F4028</Color>

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#3E7C4F" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#336742" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#3E7C4F" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#4C8D5E" />
            <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#3E7C4F" />
            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#336742" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#3E7C4F" />
            <SolidColorBrush x:Key="SystemControlHyperlinkTextBrush" Color="#336742" />

            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#E9F0DE" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#E9F0DE" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#DDE8CC" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#CFDDB7" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FAFDF4" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#F1F8E8" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#266F8C56" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FAFDF4" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0E000000" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Default">
            <Color x:Key="SystemAccentColor">#7CC08F</Color>
            <Color x:Key="SystemAccentColorLight1">#93CDA3</Color>
            <Color x:Key="SystemAccentColorLight2">#ABDAB7</Color>
            <Color x:Key="SystemAccentColorLight3">#C4E7CC</Color>
            <Color x:Key="SystemAccentColorDark1">#5FA070</Color>
            <Color x:Key="SystemAccentColorDark2">#4C8D5E</Color>
            <Color x:Key="SystemAccentColorDark3">#336742</Color>

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#7CC08F" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#ABDAB7" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#93CDA3" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#7CC08F" />
            <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#7CC08F" />
            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#ABDAB7" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#7CC08F" />
            <SolidColorBrush x:Key="SystemControlHyperlinkTextBrush" Color="#ABDAB7" />

            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#1A2312" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#1A2312" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#222D17" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#2B381D" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#26331A" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#303E20" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#28B7D09A" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#26331A" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#15FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#10FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
