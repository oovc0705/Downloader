<?xml version="1.0" encoding="utf-8" ?>
<!--
    配色方案：琥珀暖纸（默认）  色相 33°（暖橙棕）
    设计规则（换色必读，五套方案一致）：
    1. 底色不透明、带明确色相（浅色 L≈91%，深色 L≈9% 带暖）——换方案一眼可辨；
    2. 表面（卡片/输入/分层）近中性白/深灰，与底色拉开明度差，靠描边立层次，
       色相不下渗大面积表面（否则整体发灰）；
    3. 强调色只出现在交互元素；
    4. NavigationView 内容区/顶栏透明露出底色；所有填充均落在不透明底上，杜绝透色。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#C96A28</Color>
            <Color x:Key="SystemAccentColorLight1">#D67B36</Color>
            <Color x:Key="SystemAccentColorLight2">#E08A4C</Color>
            <Color x:Key="SystemAccentColorLight3">#EFAC7F</Color>
            <Color x:Key="SystemAccentColorDark1">#B45C22</Color>
            <Color x:Key="SystemAccentColorDark2">#98491A</Color>
            <Color x:Key="SystemAccentColorDark3">#7C3A13</Color>

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#C96A28" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#B45C22" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#C96A28" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#D67B36" />
            <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#C96A28" />
            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#B45C22" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#C96A28" />
            <SolidColorBrush x:Key="SystemControlHyperlinkTextBrush" Color="#B45C22" />

            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#F5E9D5" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#F5E9D5" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#EFE0C6" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#E7D4B4" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFCF5" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FBF3E4" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#26957A45" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FFFCF5" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0E000000" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Default">
            <Color x:Key="SystemAccentColor">#E08A4C</Color>
            <Color x:Key="SystemAccentColorLight1">#E99E68</Color>
            <Color x:Key="SystemAccentColorLight2">#F2B78D</Color>
            <Color x:Key="SystemAccentColorLight3">#F8CFB0</Color>
            <Color x:Key="SystemAccentColorDark1">#C96A28</Color>
            <Color x:Key="SystemAccentColorDark2">#B45C22</Color>
            <Color x:Key="SystemAccentColorDark3">#98491A</Color>

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#E08A4C" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#F2B78D" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#E99E68" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#E08A4C" />
            <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#E08A4C" />
            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#F2B78D" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#E08A4C" />
            <SolidColorBrush x:Key="SystemControlHyperlinkTextBrush" Color="#F2B78D" />

            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#211A0F" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#211A0F" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#2A2113" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#342917" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#2B2314" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#362C1A" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#28D8BC8A" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#2B2314" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#15FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#10FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
