<?xml version="1.0" encoding="utf-8" ?>
<!--
    配色方案：青空海洋  色相 190°（青）
    设计规则（换色必读，五套方案一致）：
    1. 底色不透明、带明确色相（浅色 L≈92%，深色 L≈9% 带青）——换方案一眼可辨；
    2. 表面（卡片/输入/分层）近中性白/深灰，与底色拉开明度差，靠描边立层次，
       色相不下渗大面积表面（否则整体发灰）；
    3. 强调色只出现在交互元素；
    4. NavigationView 内容区/顶栏透明露出底色；所有填充均落在不透明底上，杜绝透色。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#0F7B8A</Color>
            <Color x:Key="SystemAccentColorLight1">#1A8FA0</Color>
            <Color x:Key="SystemAccentColorLight2">#2CA6B5</Color>
            <Color x:Key="SystemAccentColorLight3">#6FC5CF</Color>
            <Color x:Key="SystemAccentColorDark1">#0C6672</Color>
            <Color x:Key="SystemAccentColorDark2">#09525C</Color>
            <Color x:Key="SystemAccentColorDark3">#073E46</Color>

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0F7B8A" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#0C6672" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#0F7B8A" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#1A8FA0" />
            <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#0F7B8A" />
            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#0C6672" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#0F7B8A" />
            <SolidColorBrush x:Key="SystemControlHyperlinkTextBrush" Color="#0C6672" />

            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#E4EEF1" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#E4EEF1" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#D7E6EB" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#C6DCE3" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#F9FDFE" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#EFF7F9" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#264E8C99" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#F9FDFE" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0E000000" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Default">
            <Color x:Key="SystemAccentColor">#4FBFCD</Color>
            <Color x:Key="SystemAccentColorLight1">#74CDD8</Color>
            <Color x:Key="SystemAccentColorLight2">#99DCE4</Color>
            <Color x:Key="SystemAccentColorLight3">#C0EAEF</Color>
            <Color x:Key="SystemAccentColorDark1">#2CA6B5</Color>
            <Color x:Key="SystemAccentColorDark2">#1A8FA0</Color>
            <Color x:Key="SystemAccentColorDark3">#0C6672</Color>

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#4FBFCD" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#99DCE4" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#74CDD8" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#4FBFCD" />
            <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#4FBFCD" />
            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#99DCE4" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#4FBFCD" />
            <SolidColorBrush x:Key="SystemControlHyperlinkTextBrush" Color="#99DCE4" />

            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#131F24" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#131F24" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#1A2930" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#21343C" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#1D2E36" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#243740" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#289CC8D4" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#1D2E36" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#15FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#10FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
