<?xml version="1.0" encoding="utf-8" ?>
<!--
    配色方案：经典蓝灰（Windows 原生观感）  色相 225°（蓝灰，低饱和）
    设计规则（换色必读，五套方案一致）：
    1. 底色不透明、带冷灰倾向（浅色 L≈95%，深色 L≈10%）——与彩色方案形成"中性"对照；
    2. 表面（卡片/输入/分层）近纯白/深灰，与底色拉开明度差，靠描边立层次；
    3. 强调色只出现在交互元素；
    4. NavigationView 内容区/顶栏透明露出底色；所有填充均落在不透明底上，杜绝透色。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#0078D4</Color>
            <Color x:Key="SystemAccentColorLight1">#429CE3</Color>
            <Color x:Key="SystemAccentColorLight2">#62B0ED</Color>
            <Color x:Key="SystemAccentColorLight3">#83C4F2</Color>
            <Color x:Key="SystemAccentColorDark1">#0067B8</Color>
            <Color x:Key="SystemAccentColorDark2">#005A9E</Color>
            <Color x:Key="SystemAccentColorDark3">#004C84</Color>

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#005A9E" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#2B88D8" />
            <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#005A9E" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="SystemControlHyperlinkTextBrush" Color="#005A9E" />

            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#EFF1F5" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#EFF1F5" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#E4E7ED" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#D6DAE3" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#F6F7FA" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#2664748B" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0E000000" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Default">
            <Color x:Key="SystemAccentColor">#4CC2FF</Color>
            <Color x:Key="SystemAccentColorLight1">#63CBFF</Color>
            <Color x:Key="SystemAccentColorLight2">#7AD4FF</Color>
            <Color x:Key="SystemAccentColorLight3">#9ADDFF</Color>
            <Color x:Key="SystemAccentColorDark1">#2B88D8</Color>
            <Color x:Key="SystemAccentColorDark2">#1E6FB8</Color>
            <Color x:Key="SystemAccentColorDark3">#0067B8</Color>

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#4CC2FF" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#99D1FF" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#7AD4FF" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#4CC2FF" />
            <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#4CC2FF" />
            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#99D1FF" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#4CC2FF" />
            <SolidColorBrush x:Key="SystemControlHyperlinkTextBrush" Color="#99D1FF" />

            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#1B1D23" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#1B1D23" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#23262E" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#2C303A" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#292C35" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#333742" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#28AEB9CC" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#292C35" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#15FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#10FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
