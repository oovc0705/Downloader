<?xml version="1.0" encoding="utf-8" ?>
<!--
    平台品牌图标（Simple Icons 矢量，品牌色，48px 光栅化保证高分屏清晰）。
    X 的标志为纯黑/纯白，浅色主题用黑、深色主题用白（ThemeDictionaries 自动切换）；
    其余品牌色（红/蓝等）在明暗背景上都可读，主题无关。
    图标数据来源 Simple Icons（CC0）；各平台商标权利归其所有者。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SvgImageSource x:Key="IconDouyin" UriSource="ms-appx:///Assets/PlatformIcons/douyin.svg" RasterizePixelWidth="48" RasterizePixelHeight="48" />
    <SvgImageSource x:Key="IconXiaohongshu" UriSource="ms-appx:///Assets/PlatformIcons/xiaohongshu.svg" RasterizePixelWidth="48" RasterizePixelHeight="48" />
    <SvgImageSource x:Key="IconBilibili" UriSource="ms-appx:///Assets/PlatformIcons/bilibili.svg" RasterizePixelWidth="48" RasterizePixelHeight="48" />
    <SvgImageSource x:Key="IconYouTube" UriSource="ms-appx:///Assets/PlatformIcons/youtube.svg" RasterizePixelWidth="48" RasterizePixelHeight="48" />
    <SvgImageSource x:Key="IconInstagram" UriSource="ms-appx:///Assets/PlatformIcons/instagram.svg" RasterizePixelWidth="48" RasterizePixelHeight="48" />

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SvgImageSource x:Key="IconX" UriSource="ms-appx:///Assets/PlatformIcons/x-black.svg" RasterizePixelWidth="48" RasterizePixelHeight="48" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SvgImageSource x:Key="IconX" UriSource="ms-appx:///Assets/PlatformIcons/x-white.svg" RasterizePixelWidth="48" RasterizePixelHeight="48" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
